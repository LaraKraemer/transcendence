meta {
  name: 22 - Create analytics EUR account
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Analytics EUR",
    "type": "checking",
    "currencyCode": "EUR"
  }
}

tests {
  test("EUR account is created", function () {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("analyticsEurAccountId", res.getBody().id);
  });
}
