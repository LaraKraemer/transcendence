meta {
  name: 06 - Create expense transaction
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accountId": "{{accountId}}",
    "type": "expense",
    "categoryId": "{{expenseCategoryId}}",
    "amountMinor": -4250,
    "notes": "Created by the Bruno collection",
    "bookedOn": "2026-08-25"
  }
}

tests {
  test("expense transaction is created", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.description).to.equal(null);
    expect(body.amountMinor).to.equal(-4250);
    bru.setVar("transactionId", body.id);
  });
}
