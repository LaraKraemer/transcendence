meta {
  name: 07 - List account transactions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/transactions?accountId={{accountId}}&type=expense
  body: none
  auth: none
}

tests {
  test("created expense is listed under the expense filter", function () {
    expect(res.getStatus()).to.equal(200);
    const { items, total } = res.getBody();
    expect(items.map((transaction) => transaction.id)).to.include(bru.getVar("transactionId"));
    expect(items.every((transaction) => transaction.type === "expense")).to.equal(true);
    expect(total).to.equal(items.length);
  });
}
