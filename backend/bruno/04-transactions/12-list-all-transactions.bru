meta {
  name: 12 - List transactions of all accounts
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/transactions?type=transfer
  body: none
  auth: none
}

tests {
  test("a transfer is one item without accountId: its source leg", function () {
    expect(res.getStatus()).to.equal(200);
    const { items, total } = res.getBody();
    expect(total).to.equal(1);
    expect(items).to.have.length(1);
    expect(items[0].id).to.equal(bru.getVar("transferSourceLegId"));
    expect(items[0].accountId).to.equal(bru.getVar("accountId"));
    expect(items[0].amountMinor).to.equal(-2500);
    expect(items[0].transferAccountId).to.equal(bru.getVar("savingsAccountId"));
    expect(items[0].transferAmountMinor).to.equal(2500);
  });
}
