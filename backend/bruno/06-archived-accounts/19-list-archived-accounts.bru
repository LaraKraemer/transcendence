meta {
  name: 19 - List archived accounts
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/accounts?archived=true
  body: none
  auth: none
}

tests {
  test("only the archived account is listed", function () {
    expect(res.getStatus()).to.equal(200);
    const ids = res.getBody().map((account) => account.id);
    expect(ids).to.include(bru.getVar("savingsAccountId"));
    expect(ids).to.not.include(bru.getVar("accountId"));
  });
}
