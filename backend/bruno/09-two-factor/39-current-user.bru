get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

tests {
  test("2FA is reported as enabled", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.twoFactorEnabled).to.equal(true);
  });
}
