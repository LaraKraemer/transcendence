meta {
  name: 38 - Recover with a recovery code
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/auth/2fa/recover
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "recoveryCode": "{{recoveryCode}}"
  }
}

tests {
  test("recovery code completes the session", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.email).to.equal(bru.getVar("twoFaEmail"));
  });
}
