meta {
  name: 04 - Create expense category
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Groceries Category",
    "icon": "shopping-cart",
    "color": "#16A34A",
    "kind": "expense"
  }
}

tests {
  test("expense category is created", function () {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("expenseCategoryId", res.getBody().id);
  });
}
