POSTGRES_EXPORTER_PASSWORD=place_your_dev_postgres_password_here
GRAFANA_ADMIN_USER=user_admin_name
GRAFANA_ADMIN_PASSWORD=place_your_dev_grafana_password_here
# Optional: enable after creating the Telegram secret files (see docs/monitoring.md).
# COMPOSE_FILE=docker-compose.yml:docker-compose.telegram.yml

# Optional Google sign-in: obtain both values from Google Cloud Console.
# Register http://localhost:3000/auth/google as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional 2FA: generate a key with openssl rand -base64 32.
# Keep this key stable; changing it invalidates stored authenticator secrets.
TOTP_ENCRYPTION_KEY=
