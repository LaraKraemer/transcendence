# Frontend environment variables.
# Copy to .env.local when running the frontend outside Docker:
#   cp .env.example .env.local
# Inside Docker, these are provided by docker-compose.yml.

# Browser-facing backend URL. Exposed to the client bundle (NEXT_PUBLIC_*),
# so it must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side backend URL, used by server components / server actions / the DAL.
# Running locally this is the same as above; inside Docker it is overridden to
# the HTTPS proxy's service hostname (https://nginx:8443) in docker-compose.yml.
API_URL=http://localhost:3001

# Google OAuth client ID (server-side only). Leave empty to disable Google sign-in.
# The backend needs the same ID; GOOGLE_CLIENT_SECRET belongs only in the backend.
GOOGLE_CLIENT_ID=
